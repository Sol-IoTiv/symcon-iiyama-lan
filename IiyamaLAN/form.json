{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "Verbindung zum Bildschirm",
            "expanded": true,
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "Adresse",
                    "caption": "IP-Adresse des Bildschirms"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "Port",
                            "caption": "TCP-Port",
                            "minimum": 1,
                            "maximum": 65535,
                            "width": "120px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "MonitorID",
                            "caption": "Monitor-ID",
                            "minimum": 1,
                            "maximum": 255,
                            "width": "120px"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Am Bildschirm Menü → Gerät → RS232-Weiterleitung / RS232 routing öffnen und LAN RS232 auswählen."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Automatische Statusabfrage",
            "expanded": true,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "Abfrageintervall",
                    "caption": "Abfrageintervall in Sekunden (0 = aus)",
                    "minimum": 0,
                    "maximum": 86400
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Quellcodes für USB-C und Datei-Manager",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Quelle am Bildschirm wählen und unter „Bildschirm bedienen“ ihren Quellcode lesen. 0 bedeutet nicht zugeordnet."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "UsbCQuellcode",
                            "caption": "USB-C",
                            "minimum": 0,
                            "maximum": 255,
                            "width": "165px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "DateimanagerQuellcode",
                            "caption": "Datei-Manager",
                            "minimum": 0,
                            "maximum": 255,
                            "width": "165px"
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "ExpansionPanel",
            "caption": "Status und Geräteinformationen",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Status aktualisieren",
                            "onClick": "IIY_Aktualisieren($id);"
                        },
                        {
                            "type": "Button",
                            "caption": "Geräteinformationen aktualisieren",
                            "onClick": "IIY_GeraeteinformationenAktualisieren($id);"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Bildschirm bedienen",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Ein und HDMI 1",
                            "onClick": "IIY_EinHDMI1($id);"
                        },
                        {
                            "type": "Button",
                            "caption": "Ein und HDMI 2",
                            "onClick": "IIY_EinHDMI2($id);"
                        },
                        {
                            "type": "Button",
                            "caption": "Standby",
                            "onClick": "IIY_Standby($id);"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Eingang umschalten"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "HDMI 1",
                            "onClick": "IIY_EingangSetzen($id, 0x0D);"
                        },
                        {
                            "type": "Button",
                            "caption": "HDMI 2",
                            "onClick": "IIY_EingangSetzen($id, 0x06);"
                        },
                        {
                            "type": "Button",
                            "name": "UsbCButton",
                            "caption": "USB-C",
                            "enabled": false
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Webplayer",
                            "onClick": "IIY_EingangSetzen($id, 0x10);"
                        },
                        {
                            "type": "Button",
                            "caption": "CMS",
                            "onClick": "IIY_EingangSetzen($id, 0x11);"
                        },
                        {
                            "type": "Button",
                            "name": "DateimanagerButton",
                            "caption": "Datei-Manager",
                            "enabled": false
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Medienplayer",
                            "onClick": "IIY_EingangSetzen($id, 0x16);"
                        },
                        {
                            "type": "Button",
                            "caption": "PDF-Abspieler",
                            "onClick": "IIY_EingangSetzen($id, 0x17);"
                        },
                        {
                            "type": "Button",
                            "caption": "Benutzerdefiniert",
                            "onClick": "IIY_EingangSetzen($id, 0x18);"
                        }
                    ]
                },
                {
                    "type": "Button",
                    "caption": "Aktuellen Quellcode lesen",
                    "onClick": "echo IIY_QuellcodeLesen($id);"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Wochenzeitplan am Bildschirm",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Der Bildschirm speichert und führt den Zeitplan nach seiner eigenen Uhr aus."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "PlanNummer",
                            "caption": "Zeitplan-Nr.",
                            "options": [
                                {
                                    "caption": "1",
                                    "value": 1
                                },
                                {
                                    "caption": "2",
                                    "value": 2
                                },
                                {
                                    "caption": "3",
                                    "value": 3
                                },
                                {
                                    "caption": "4",
                                    "value": 4
                                },
                                {
                                    "caption": "5",
                                    "value": 5
                                },
                                {
                                    "caption": "6",
                                    "value": 6
                                },
                                {
                                    "caption": "7",
                                    "value": 7
                                }
                            ],
                            "value": 1,
                            "width": "125px",
                            "onChange": "IIY_ZeitplanFormularLaden($id, (int) $PlanNummer);"
                        },
                        {
                            "type": "Select",
                            "name": "PlanQuelle",
                            "caption": "Eingang",
                            "options": [
                                {
                                    "caption": "HDMI 1",
                                    "value": 13
                                },
                                {
                                    "caption": "HDMI 2",
                                    "value": 6
                                },
                                {
                                    "caption": "Eingang wählen",
                                    "value": 0
                                }
                            ],
                            "value": 13,
                            "width": "145px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "PlanEin",
                            "caption": "Ein (HH:MM)",
                            "value": "07:00",
                            "width": "125px"
                        },
                        {
                            "type": "ValidationTextBox",
                            "name": "PlanAus",
                            "caption": "Aus (HH:MM)",
                            "value": "20:00",
                            "width": "125px"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Wochentage"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "PlanMontag",
                            "caption": "Mo",
                            "value": true
                        },
                        {
                            "type": "CheckBox",
                            "name": "PlanDienstag",
                            "caption": "Di",
                            "value": true
                        },
                        {
                            "type": "CheckBox",
                            "name": "PlanMittwoch",
                            "caption": "Mi",
                            "value": true
                        },
                        {
                            "type": "CheckBox",
                            "name": "PlanDonnerstag",
                            "caption": "Do",
                            "value": true
                        },
                        {
                            "type": "CheckBox",
                            "name": "PlanFreitag",
                            "caption": "Fr",
                            "value": true
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "PlanSamstag",
                            "caption": "Sa",
                            "value": false
                        },
                        {
                            "type": "CheckBox",
                            "name": "PlanSonntag",
                            "caption": "So",
                            "value": false
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Zeitplan lesen",
                            "onClick": "IIY_ZeitplanFormularLaden($id, (int) $PlanNummer);"
                        },
                        {
                            "type": "Button",
                            "caption": "Zeitplan deaktivieren",
                            "onClick": "IIY_ZeitplanDeaktivieren($id, (int) $PlanNummer); echo 'Zeitplan deaktiviert.';"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "name": "PlanStatus",
                    "caption": "Geladener Zeitplan",
                    "visible": false
                },
                {
                    "type": "Button",
                    "caption": "Zeitplan speichern und aktivieren",
                    "onClick": "IIY_ZeitplanSetzen($id, (int) $PlanNummer, $PlanEin, $PlanAus, (int) $PlanQuelle, ($PlanMontag ? 2 : 0) | ($PlanDienstag ? 4 : 0) | ($PlanMittwoch ? 8 : 0) | ($PlanDonnerstag ? 16 : 0) | ($PlanFreitag ? 32 : 0) | ($PlanSamstag ? 64 : 0) | ($PlanSonntag ? 128 : 0)); echo 'Zeitplan gespeichert und zurückgelesen.';"
                }
            ]
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Instanz eingerichtet"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "IP-Adresse, Port oder Monitor-ID ungültig"
        }
    ]
}
